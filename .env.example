# ---- 服务 ----
PORT=8849
NODE_ENV=development
DATABASE_URL=postgres://tutor:tutor@localhost:5432/tutor
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 鉴权（单账号） ----
JWT_SECRET=change-me
JWT_EXPIRES_IN=2h
REFRESH_TOKEN_TTL_DAYS=14
AUTH_USERNAME=student
AUTH_PASSWORD=change-me-too

# ---- 大模型（OpenAI 兼容协议） ----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat
# 备援通道，留空则不启用
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# ---- Embedding / Reranker ----
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# 若模型支持 dimensions 参数（如智谱 embedding-3，原生 2048 维需压到 1024）设为 true；
# bge-m3 这类固定维度模型必须保持 false
EMBEDDING_SEND_DIM=false
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=sk-xxx
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 置空 RERANK_BASE_URL 或设置 RERANK=false 可关闭精排（检索降级为 RRF 排序，日志含 rerank_fallback）

# ---- RAG 参数 ----
RAG_TOP_K_VECTOR=20
RAG_TOP_K_KEYWORD=20
RAG_TOP_K_FINAL=6
# 消融开关（评测时可被 query 参数覆盖）
RERANK=true
PROFILE_INJECT=true
WRONGBOOK_INJECT=true

# ---- 队列与评测 ----
VARIANT_CONCURRENCY=2
EVAL_LIMIT=20

# ---- 前端 ----
VITE_API_BASE=http://localhost:8849/api

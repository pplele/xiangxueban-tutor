    "@tutor/shared": "1.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jieba-wasm": "^2.4.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "pino-pretty": "^13.0.0",

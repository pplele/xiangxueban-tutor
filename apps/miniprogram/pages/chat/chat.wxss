.page {
  /* 底部输入栏固定，留出高度 + iPhone 安全区，否则最后一条消息会被挡住 */
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.banner {
  margin: 24rpx 24rpx 0;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 27rpx;
}

.banner.danger {
  background: #fff1f0;
  border: 1rpx solid #ffa39e;
  color: #a8071a;
}

.banner.warn {
  background: #fffbe6;
  border: 1rpx solid #ffe58f;
  color: #874d00;
}

.banner-title {
  font-weight: 600;
  margin-bottom: 12rpx;
}

.banner-item {
  margin-top: 12rpx;
  /* rich-text 里的分式会上下叠放，行高要给够 */
  line-height: 1.7;
}

.banner-label {
  font-size: 23rpx;
  opacity: 0.7;
  margin-bottom: 2rpx;
}

.banner-muted {
  opacity: 0.7;
}

.banner-sub {
  font-size: 24rpx;
  opacity: 0.75;
  margin-top: 4rpx;
}

.ellipsis {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.q-card {
  margin-bottom: 8rpx;
}

.q-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.q-label {
  font-size: 24rpx;
  color: #8a9099;
}

.q-toggle {
  font-size: 24rpx;
  color: #1f6feb;
}

.q-text {
  font-size: 30rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}

/* ---------- 对话流 ---------- */
.dialog {
  padding: 16rpx 24rpx 0;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.msg-row.user {
  flex-direction: row-reverse;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #1f6feb;
  color: #ffffff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.bubble {
  max-width: 82%;
  box-sizing: border-box;
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
  font-size: 29rpx;
  line-height: 1.7;
  word-break: break-word;
}

.bubble.assistant {
  background: #ffffff;
  border: 1rpx solid #ebedf0;
  border-top-left-radius: 8rpx;
}

.bubble.user {
  background: #1f6feb;
  border-top-right-radius: 8rpx;
}

.user-text {
  color: #ffffff;
  font-size: 29rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}

/* rich-text 内部样式全部内联在 utils/md.js 里，这里只管容器 */
.answer-md {
  display: block;
  width: 100%;
  word-break: break-word;
}

.typing {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 26rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #1f6feb;
}

.loading-text {
  color: #5a6069;
  font-size: 27rpx;
}

.cites {
  margin-top: 24rpx;
  border-top: 1rpx solid #eef0f3;
  padding-top: 18rpx;
}

.cites-title {
  font-size: 24rpx;
  color: #8a9099;
  margin-bottom: 10rpx;
}

.cite {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 6rpx 0;
  font-size: 24rpx;
  color: #5a6069;
}

.cite-src {
  flex: 1;
  word-break: break-all;
}

.cite-kp {
  color: #1f6feb;
  white-space: nowrap;
}

.msg-tools {
  display: inline-block;
  margin-top: 18rpx;
  padding: 8rpx 22rpx;
  border: 1rpx solid #d5dae1;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: #5a6069;
  background: #ffffff;
}

.msg-tools:active {
  background: #f2f3f5;
}

.err-box {
  margin: 8rpx 24rpx 0;
  background: #fff1f0;
  border: 1rpx solid #ffa39e;
  border-radius: 16rpx;
  padding: 24rpx;
}

.err-text {
  color: #a8071a;
  font-size: 27rpx;
  line-height: 1.6;
}

/* ---------- 快捷追问 ---------- */
.quick {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx 24rpx 0;
}

.chip {
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #c7d9f7;
  color: #1f4f9c;
  font-size: 26rpx;
}

.chip:active {
  background: #eef4ff;
}

/* ---------- 底部操作 ---------- */
.footer {
  padding: 28rpx 24rpx 0;
}

.footer-hint {
  margin-top: 16rpx;
  text-align: center;
  font-size: 23rpx;
  color: #8a9099;
}

/* ---------- 输入栏 ---------- */
.composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #e8eaed;
  z-index: 9;
}

.composer-input {
  flex: 1;
  min-height: 76rpx;
  max-height: 220rpx;
  box-sizing: border-box;
  background: #f5f6f8;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  font-size: 29rpx;
  line-height: 1.5;
}

.composer-btn {
  flex-shrink: 0;
  padding: 18rpx 30rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #ffffff;
  background: #c9d3e0;
}

.composer-save {
  flex-shrink: 0;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #1f4f9c;
  background: #eef4ff;
  border: 1rpx solid #c7d9f7;
}

.composer-save:active {
  background: #dbe8ff;
}

.composer-btn.on {
  background: #1f6feb;
}

.composer-btn:active {
  opacity: 0.85;
}

/* ---------- 保存弹层 ---------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 10;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 36rpx 32rpx calc(56rpx + env(safe-area-inset-bottom));
  z-index: 11;
  max-height: 88vh;
  overflow-y: auto;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
}

.sheet-sub {
  font-size: 24rpx;
  color: #8a9099;
  margin-top: 8rpx;
}

.field-label {
  font-size: 25rpx;
  color: #5a6069;
  margin: 24rpx 0 10rpx;
}

.field-tip {
  color: #1f6feb;
  font-size: 23rpx;
  margin-left: 12rpx;
}

.field {
  width: 100%;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.65;
  min-height: 120rpx;
}

.field-readonly {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 27rpx;
  color: #5a6069;
  max-height: 200rpx;
  overflow: hidden;
}

.topbar {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 24rpx 0;
}

.capture {
  margin-top: 24rpx;
  border: 2rpx dashed #c9d3e0;
  border-radius: 16rpx;
  padding: 56rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fafbfc;
}

.capture-box {
  width: 56rpx;
  height: 44rpx;
  border: 3rpx solid #9aa7b8;
  border-radius: 8rpx;
  position: relative;
}

.capture-box::after {
  content: "";
  position: absolute;
  top: 8rpx;
  left: 50%;
  margin-left: -9rpx;
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid #9aa7b8;
  border-radius: 50%;
}

.capture-text {
  margin-top: 16rpx;
  color: #5a6069;
  font-size: 28rpx;
}

.shot {
  width: 100%;
  margin-top: 24rpx;
  border-radius: 12rpx;
  background: #f2f4f7;
}

.retake {
  margin-top: 16rpx;
  text-align: center;
  color: #1f6feb;
  font-size: 28rpx;
}

.input {
  margin-top: 20rpx;
  width: 100%;
  min-height: 160rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 24rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  line-height: 1.7;
}

.ask-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.input-inline {
  flex: 1;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.voice {
  padding: 20rpx 26rpx;
  border-radius: 12rpx;
  background: #eef4ff;
  color: #1f4f9c;
  font-size: 26rpx;
  white-space: nowrap;
}

.voice.recording {
  background: #1f6feb;
  color: #ffffff;
}

.footer {
  padding: 8rpx 24rpx 48rpx;
}

.link {
  text-align: center;
  color: #8a9099;
  font-size: 26rpx;
  margin-top: 28rpx;
}

.preview {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border: 1rpx solid #e5e6eb;
  border-radius: 12rpx;
}

.preview-label {
  font-size: 22rpx;
  color: #8a9099;
  margin-bottom: 10rpx;
}
